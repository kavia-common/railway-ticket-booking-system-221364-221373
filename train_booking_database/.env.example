# PostgreSQL container configuration (documentation only; do not commit secrets to .env)
# Provide these via the orchestrator to override defaults in scripts.

# PUBLIC_INTERFACE
# POSTGRES_DB: Name of the database to create/use
POSTGRES_DB=myapp

# PUBLIC_INTERFACE
# POSTGRES_USER: Application database user
POSTGRES_USER=appuser

# PUBLIC_INTERFACE
# POSTGRES_PASSWORD: Password for POSTGRES_USER
POSTGRES_PASSWORD=dbuser123

# PUBLIC_INTERFACE
# POSTGRES_PORT: Port PostgreSQL will listen on (expected by platform)
POSTGRES_PORT=5001

# Note: Scripts currently derive values internally but can be adapted to read from env.
# Ensure backend uses: postgresql://appuser:dbuser123@localhost:5001/myapp
